# Copy to .env and fill in. .env is git-ignored and never deployed.

# https://elevenlabs.io/app/settings/api-keys  (needs Sound Effects + Music permissions)
ELEVENLABS_API_KEY=

# Public URL of the hosted multiplayer server (Render/Railway), e.g. wss://wild-survivors-server.onrender.com
# Leave empty to deploy in Solo/Offline mode.
VITE_WS_URL=

# Claude Code Session
CLAUDE_CODE_SESSION_URL=
CLAUDE_CODE_SESSION_ID=
