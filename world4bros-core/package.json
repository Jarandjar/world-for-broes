{
  "name": "world-4-bros-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "test:fast": "node --import tsx --test tests/arena-bots.test.ts tests/arena.test.ts tests/weapons-food.test.ts tests/zombie.test.ts",
    "test:combat": "node --import tsx --test tests/arena-bots.test.ts tests/arena.test.ts tests/swarm.test.ts tests/zombie.test.ts",
    "art:catalog": "tsx tools/asset-catalog.ts",
    "art:slice": "node tools/run-blender.mjs --slice",
    "art:render": "node tools/run-blender.mjs",
    "art:ue": "node tools/run-blender.mjs --slice --unreal-export",
    "arena:export": "tsx tools/export-unreal.ts",
    "ue:export": "tsx tools/export-unreal.ts",
    "ue:doctor": "node tools/unreal/pipeline/w4b-ue.mjs doctor",
    "ue:arena": "node tools/unreal/pipeline/w4b-ue.mjs arena",
    "ue:shots": "node tools/unreal/pipeline/w4b-ue.mjs shots",
    "ue:import": "node tools/unreal/pipeline/w4b-ue.mjs import",
    "ue:remote": "node tools/unreal/pipeline/w4b-ue.mjs remote",
    "bundle": "node tools/bundle-single.mjs",
    "foundry": "node tools/city_foundry_server.mjs",
    "ue:open": "node tools/unreal/pipeline/w4b-ue.mjs open",
    "ue:build:arena": "node tools/unreal/pipeline/w4b-ue.mjs arena",
    "ue:sim:headless": "node tools/unreal/pipeline/w4b-ue.mjs sim-headless",
    "ue:test:window": "node tools/run-unreal.mjs test-window",
    "ue:build:arena:isometric": "node tools/run-unreal.mjs build-arena --preset=isometric-square",
    "telemetry:spark": "python tools/spark/analyze_swarm.py --input tools/spark/input/*.csv --output tools/spark/out",
    "toolkit:fetch": "pwsh -ExecutionPolicy Bypass -File tools/vendor/fetch-toolkit.ps1",
    "toolkit:fetch:tools": "pwsh -ExecutionPolicy Bypass -File tools/vendor/fetch-toolkit.ps1 -IncludeToolsOnly",
    "toolkit:fetch:all": "pwsh -ExecutionPolicy Bypass -File tools/vendor/fetch-toolkit.ps1 -IncludeToolsOnly -IncludeStudyOnly"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
